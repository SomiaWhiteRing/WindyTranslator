{
  "manifest_version": 1,
  "id": "rpg_maker_proofreading",
  "category": "gui",
  "name": "RPG 制作大师校对工具",
  "version": "4.1.0",
  "author": "JerryHOEI",
  "description": "检查 RPG Maker 翻译文本、辞典、标点和格式。",
  "runtime": "host_python",
  "entry": "workbench_app.py",
  "working_directory": ".",
  "arguments": [
    {
      "name": "input",
      "flag": "--initial-input",
      "type": "current_game_file",
      "source": "translated/translation_translated.json",
      "required": true,
      "label": "译文 JSON 文件"
    },
    {
      "name": "source_type",
      "flag": "--initial-source-type",
      "type": "fixed",
      "value": "json"
    }
  ]
}
