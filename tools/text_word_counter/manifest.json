{
  "manifest_version": 1,
  "id": "text_word_counter",
  "name": "翻译文本字数统计",
  "version": "1.0.0",
  "author": "WindyTranslator",
  "description": "统计当前游戏原文 JSON 和译文 JSON 的条目与字符数。",
  "category": "cli",
  "runtime": "host_python",
  "entry": "word_counter.py",
  "working_directory": ".",
  "arguments": [
    {
      "name": "original_json",
      "flag": "--original-json",
      "type": "current_game_file",
      "source": "untranslated/translation.json",
      "label": "原文 JSON 文件",
      "required": true
    },
    {
      "name": "translated_json",
      "flag": "--translated-json",
      "type": "current_game_file",
      "source": "translated/translation_translated.json",
      "label": "译文 JSON 文件",
      "required": true
    }
  ]
}
