{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "argument": {
      "type": "object",
      "required": ["name", "flag", "type"],
      "properties": {
        "name": {"type": "string"},
        "flag": {"type": "string"},
        "type": {"enum": ["game_path", "current_game_file", "modules", "fixed"]},
        "required": {"type": "boolean"},
        "value": {},
        "source": {"type": "string"},
        "label": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "current_game_file"}}}, "then": {"required": ["source"]}},
        {"if": {"properties": {"type": {"const": "modules"}}}, "then": {"required": ["source"], "not": {"required": ["value"]}}},
        {"if": {"properties": {"type": {"const": "fixed"}}}, "then": {"required": ["value"], "not": {"required": ["source"]}}, "else": {"not": {"required": ["value"]}}}
      ],
      "additionalProperties": false
    }
  },
  "required": ["manifest_version", "id", "name", "version", "author", "category", "entry", "runtime"],
  "properties": {
    "manifest_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "author": {"type": "string"},
    "description": {"type": "string"},
    "category": {"enum": ["gui", "cli"]},
    "runtime": {"enum": ["host_python", "exe"]},
    "entry": {"type": "string"},
    "working_directory": {"type": "string"},
    "resources": {"type": "array", "items": {"type": "string"}},
    "arguments": {
      "type": "array",
      "items": {"$ref": "#/$defs/argument"}
    },
    "launch_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "arguments"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "arguments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/argument"}}
        },
        "additionalProperties": false
      }
    },
    "launch_options_label": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {"required": ["launch_options"]},
      "then": {"properties": {"arguments": {"maxItems": 0}}},
      "else": {
        "required": ["arguments"],
        "not": {"required": ["launch_options_label"]}
      }
    }
  ],
  "additionalProperties": false
}
